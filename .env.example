# Public Astro build configuration. Values here are safe preview defaults, not approval.
# Build flags are embedded in public output; NEVER place secrets or operator emails here.
PUBLIC_SITE_RELEASED=false
PUBLIC_ALLOW_INDEXING=false
PUBLIC_ENQUIRIES_ENABLED=false
PUBLIC_TURNSTILE_SITE_KEY=
# Optional owner policy: PUBLIC_AI_TRAINING=disallow. Leave unset until decided.
# Preview robots remain disallow-all regardless of training policy.

# Runtime configuration is separate from Astro build-time variables:
# wrangler.jsonc: ENQUIRIES_ENABLED, ALLOWED_ORIGINS, and environment-specific DB binding.
# Cloudflare staging secret store: TURNSTILE_SECRET (test key only in isolated staging).
# Cloudflare encrypted operator bindings: OPERATOR_ACCESS_TEAM_DOMAIN,
# OPERATOR_ACCESS_AUD, OPERATOR_EMAILS. Never copy staging access/data to production.
# Local Worker secrets, if needed, belong in ignored .dev.vars, never this file.
# The email consumer is dormant; no deployed Worker email credential binding exists.
# Manual receipt probe only: protected GitHub environment twn-email-receipt,
# secret TWN_RESEND_STAGING_API_KEY. This does not provision a Worker sending key.
# See docs/deployment.md, docs/operator-workflow.md and docs/email-notifications.md.
