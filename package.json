{
  "name": "the-wedding-nest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Wedding Nest — premium wedding and event experiences in Hyderabad.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cross": "E2E_CROSS_BROWSER=1 playwright test --project=firefox --project=webkit --project=webkit-mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm run test && npm run build && npm run build:submit && npm run test:e2e && npm run test:runtime",
    "test:runtime": "E2E_TARGET=workerd playwright test",
    "test:editorial-fixtures": "node scripts/verify-editorial-fixtures.mjs",
    "build:submit": "PUBLIC_ENQUIRIES_ENABLED=true PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA ASTRO_OUT_DIR=./dist-submit astro build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "gsap": "^3.15.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
