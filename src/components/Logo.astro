---
/**
 * Official TWN logo (vector, extracted from the owner-supplied TWN_Logo.ai — see docs/brand-assets.md).
 * Inline SVG so it inherits `currentColor` (official single-colour variant): ink on light, ivory on dark.
 */
import horizontal from "../assets/brand/twn-logo-horizontal.svg?raw";
import emblem from "../assets/brand/twn-emblem.svg?raw";

interface Props {
  variant?: "horizontal" | "emblem";
  class?: string;
}
const { variant = "horizontal", class: className = "" } = Astro.props;
const svg = (variant === "emblem" ? emblem : horizontal).replace(
  "<svg ",
  '<svg class="block h-full w-auto" focusable="false" ',
);
---

<span class:list={["inline-block", className]} set:html={svg} />
