---
import lockup from "../assets/brand/twn-lockup-ivory.svg?url";
import { NAV, SITE } from "../lib/site/config";
const year = new Date().getFullYear();
---

<footer class="on-dark bg-kohl text-stone">
  <div class="footer-invite relative mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 pt-24 md:pt-36">
    <div class="footer-arches" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <p class="eyebrow text-saffron">Begin planning</p>
    <p class="footer-invite-title mt-5 text-ivory">
      Your celebration <em class="italic text-saffron font-[300]">begins here.</em>
    </p>
    <a href="/plan-your-event/" class="btn-grand mt-10">
      <span>Plan your event</span>
      <span class="btn-grand-chip" aria-hidden="true">
        →
      </span>
    </a>
  </div>
  <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 pt-20 md:pt-28 pb-10">
    <div class="grid gap-14 md:grid-cols-12">
      <div class="md:col-span-5">
        <img
          src={lockup}
          alt="The Wedding Nest — Where Tradition Meets Elegance"
          width="210"
          height="195"
          loading="lazy"
          class="h-auto w-[190px] sm:w-[210px]"
        />
        <p class="mt-6 max-w-sm text-sand">
          Weddings and celebrations, planned and styled in {SITE.region}.
        </p>
      </div>
      <nav aria-label="Footer" class="md:col-span-3">
        <h2 class="eyebrow text-sand font-sans">Explore</h2>
        <ul class="mt-5 space-y-3">
          {NAV.map((item) => (
            <li>
              <a href={item.href} class="link-underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="md:col-span-4">
        <h2 class="eyebrow text-sand font-sans">Get in touch</h2>
        <ul class="mt-5 space-y-3">
          <li>
            <a href={`tel:${SITE.phone}`} class="link-underline">
              {SITE.phoneDisplay}
            </a>
          </li>
          <li>
            <a href={`mailto:${SITE.email}`} class="link-underline break-words">
              {SITE.email}
            </a>
          </li>
          <li>
            <a href={SITE.whatsapp} class="link-underline" rel="noopener" target="_blank">
              WhatsApp<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={SITE.instagram} class="link-underline" rel="noopener" target="_blank">
              Instagram — @twn.events<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={SITE.facebook} class="link-underline" rel="noopener" target="_blank">
              Facebook — twn.events<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
        </ul>
        <address class="mt-8 text-sm not-italic text-sand/90">
          {SITE.address.street}
          <br />
          {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}
        </address>
        <p class="mt-3 text-sm text-sand/90">Open {SITE.hours}</p>
        <p class="mt-3 text-sm text-sand/90">
          {SITE.founder.role}: {SITE.founder.name},{" "}
          <a href={`tel:${SITE.founder.phone}`} class="link-underline">
            {SITE.founder.phoneDisplay}
          </a>
        </p>
      </div>
    </div>
    <span class="rule mt-16 text-sand"></span>
    <p class="mt-6 text-xs text-sand/80">
      © {year} {SITE.name}. Hyderabad, India.
    </p>
  </div>
</footer>
