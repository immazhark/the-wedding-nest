---
/**
 * Photography-ready frame. With `image`, renders responsive AVIF/WebP via astro:assets at the
 * photograph's chosen ratio and focal point. Without it, renders a quiet, clearly labelled
 * placeholder — never stock or generated imagery presented as TWN work.
 *
 * `ratio` may differ per breakpoint by passing a class (e.g. "aspect-[4/5] md:aspect-[21/9]").
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { RATIOS, focalClass, type Focal, type Ratio } from "../../lib/media/schema";

interface Props {
  image?: ImageMetadata | undefined;
  alt?: string;
  ratio?: Ratio | undefined;
  /** Overrides `ratio` with explicit (responsive) aspect classes. */
  aspectClass?: string | undefined;
  focal?: Focal;
  caption?: string | undefined;
  credit?: string | undefined;
  /** Placeholder label: what kind of photograph belongs here. */
  placeholder?: string;
  /** Opening/LCP image: eager + high fetch priority. */
  priority?: boolean;
  sizes?: string;
  tone?: "light" | "dark";
  class?: string;
  /** Extra classes for the inner media layer (used for motion). */
  mediaClass?: string;
}

const {
  image,
  alt = "",
  ratio = "landscape",
  aspectClass,
  focal = "center",
  caption,
  credit,
  placeholder = "Photograph to come",
  priority = false,
  sizes = "100vw",
  tone = "light",
  class: className = "",
  mediaClass = "",
} = Astro.props;
const aspect = aspectClass ?? RATIOS[ratio];
---

<figure class:list={["frame", className]} data-frame={image ? "image" : "placeholder"}>
  <div
    class:list={["relative overflow-hidden", aspect, tone === "dark" ? "bg-kohl-soft" : "bg-stone"]}
  >
    {image ? (
      <Picture
        src={image}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes={sizes}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        class:list={[
          "frame-media absolute inset-0 h-full w-full object-cover",
          focalClass(focal),
          mediaClass,
        ]}
      />
    ) : (
      <div class:list={["frame-media absolute inset-0", mediaClass]} aria-hidden="true">
        <div class="frame-plate absolute inset-0" />
        <span class="crop crop-tl" />
        <span class="crop crop-tr" />
        <span class="crop crop-bl" />
        <span class="crop crop-br" />
      </div>
    )}
    {!image && (
      <p
        class:list={[
          "absolute left-4 top-4 sm:left-5 sm:top-5 max-w-[16rem] text-[0.6875rem] leading-snug tracking-[0.14em] uppercase",
          tone === "dark" ? "text-sand/80" : "text-muted",
        ]}
      >
        <span class="block font-semibold">Photograph to come</span>
        <span class="mt-1 block normal-case tracking-normal text-[0.8125rem]">{placeholder}</span>
      </p>
    )}
  </div>
  {(caption || credit) && (
    <figcaption class="mt-3 flex flex-wrap justify-between gap-x-6 gap-y-1 text-[0.8125rem] text-muted">
      {caption && <span>{caption}</span>}
      {credit && <span class="tracking-wide">Photograph: {credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  /* Art director's crop marks: reads as a deliberate photo slot, not an empty box. */
  .crop {
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    border-color: color-mix(in srgb, var(--color-ink) 28%, transparent);
    border-style: solid;
    border-width: 0;
  }
  .crop-tl {
    right: 1.1rem;
    top: 1.1rem;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .crop-tr {
    display: none;
  }
  .crop-bl {
    left: 1.1rem;
    bottom: 1.1rem;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .crop-br {
    right: 1.1rem;
    bottom: 1.1rem;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  :global(.bg-kohl-soft) .crop {
    border-color: rgb(205 191 166 / 0.35);
  }
  /* Quiet tonal plate: a soft light fall-off suggests a photograph's depth without imitating one. */
  .frame-plate {
    background:
      radial-gradient(120% 90% at 30% 20%, rgb(255 255 255 / 0.35), transparent 60%),
      linear-gradient(180deg, transparent 55%, rgb(29 26 22 / 0.06));
  }
  [data-frame="placeholder"] :global(.bg-kohl-soft) .frame-plate {
    background:
      radial-gradient(120% 90% at 30% 20%, rgb(255 255 255 / 0.06), transparent 60%),
      linear-gradient(180deg, transparent 55%, rgb(0 0 0 / 0.25));
  }
</style>
