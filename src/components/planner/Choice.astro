---
// Native checkbox/radio styled as an editorial selection tile. The input stays focusable
// and announced normally; the label carries the visual state via :has().
interface Props {
  type: "checkbox" | "radio";
  name: string;
  value: string;
  label: string;
  hint?: string | undefined;
  onlyFor?: readonly string[] | undefined;
  swatch?: string | undefined;
}
const { type, name, value, label, hint, onlyFor, swatch } = Astro.props;
---

<label class="choice" data-only-for={onlyFor?.join(" ")}>
  <input class="choice-input" type={type} name={name} value={value} />
  <span class="choice-mark" aria-hidden="true"></span>
  {swatch && <span class:list={["swatch", `swatch-${swatch}`]} aria-hidden="true" />}
  <span class="choice-text">
    <span class="choice-label">{label}</span>
    {hint && <span class="choice-hint">{hint}</span>}
  </span>
</label>
