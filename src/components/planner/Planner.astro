---
import Choice from "./Choice.astro";
import {
  BUDGETS,
  CONTACT_CHANNELS,
  OCCASIONS,
  SCOPES,
  SERVICES,
  STAGES,
  STYLES,
} from "../../lib/enquiry/schema";
import { LIMITS } from "../../lib/enquiry/validate";
import { SITE } from "../../lib/site/config";

// DRAFT COPY — labels, privacy wording and budget bands need owner approval.
const weddings = OCCASIONS.filter((o) => o.group === "wedding");
const celebrations = OCCASIONS.filter((o) => o.group === "celebration");
const serviceOnlyFor = (s: (typeof SERVICES)[number]) => ("onlyFor" in s ? s.onlyFor : undefined);
---

<div class="planner" data-planner>
  <noscript>
    <p class="planner-panel text-charcoal">
      The planner needs JavaScript. You can reach The Wedding Nest on{" "}
      <a href={SITE.instagram} class="underline decoration-brass underline-offset-4">
        Instagram
      </a>
      in the meantime.
    </p>
  </noscript>

  <div class="js-only grid gap-10 lg:grid-cols-12">
    <!-- Progress -->
    <nav class="lg:col-span-4" aria-label="Planner progress">
      <p class="eyebrow text-brass-deep" data-step-count>
        Step 1 of 5
      </p>
      <div class="mt-3 h-px w-full bg-ink/15 lg:hidden" aria-hidden="true">
        <div class="progress-bar h-px bg-brass-deep" data-progress-bar></div>
      </div>
      <ol class="mt-6 hidden lg:block border-t border-ink/15">
        {STAGES.map((stage, i) => (
          <li class="progress-item border-b border-ink/15" data-progress-item={stage.id}>
            <span class="progress-num font-display" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="progress-title">{stage.title}</span>
          </li>
        ))}
      </ol>
    </nav>

    <form class="lg:col-span-8" novalidate data-planner-form aria-describedby="planner-privacy">
      <p id="planner-privacy" class="sr-only">
        Your choices stay in this browser. Name and phone number are never saved or sent by this
        preview.
      </p>

      <!-- 1. Occasion -->
      <fieldset class="stage" data-stage="occasion">
        <legend class="stage-legend">
          <h2 class="stage-title" tabindex="-1">
            What are you celebrating?
          </h2>
        </legend>
        <p class="stage-intro">Choose all that apply — many families plan several together.</p>
        <p class="group-label">Weddings</p>
        <div class="choices">
          {weddings.map((o) => (
            <Choice type="checkbox" name="occasions" value={o.id} label={o.label} />
          ))}
        </div>
        <p class="group-label">Other celebrations</p>
        <div class="choices">
          {celebrations.map((o) => (
            <Choice type="checkbox" name="occasions" value={o.id} label={o.label} />
          ))}
        </div>
      </fieldset>

      <!-- 2. Scope -->
      <fieldset class="stage" data-stage="scope" hidden>
        <legend class="stage-legend">
          <h2 class="stage-title" tabindex="-1">
            How can we help?
          </h2>
        </legend>
        <div class="choices choices-wide">
          {SCOPES.map((s) => (
            <Choice type="radio" name="scope" value={s.id} label={s.label} hint={s.hint} />
          ))}
        </div>
        <fieldset class="mt-10" data-services hidden>
          <legend class="group-label">Which services would you like to discuss?</legend>
          <div class="choices">
            {SERVICES.map((s) => (
              <Choice
                type="checkbox"
                name="services"
                value={s.id}
                label={s.label}
                onlyFor={serviceOnlyFor(s)}
              />
            ))}
          </div>
          <p class="stage-note">
            Options are tailored to your occasion. Listing a service doesn’t confirm availability —
            we’ll talk it through with you.
          </p>
        </fieldset>
      </fieldset>

      <!-- 3. Style -->
      <fieldset class="stage" data-stage="style" hidden>
        <legend class="stage-legend">
          <h2 class="stage-title" tabindex="-1">
            Which mood feels closest?
          </h2>
        </legend>
        <p class="stage-intro">Optional — pick any that appeal, or skip ahead.</p>
        <div class="choices choices-wide">
          {STYLES.map((s) => (
            <Choice
              type="checkbox"
              name="styles"
              value={s.id}
              label={s.label}
              hint={s.hint}
              swatch={s.id}
            />
          ))}
        </div>
        <p class="stage-note">Colour notes are illustrative moods, not photographs of our work.</p>
      </fieldset>

      <!-- 4. Logistics -->
      <fieldset class="stage" data-stage="logistics" hidden>
        <legend class="stage-legend">
          <h2 class="stage-title" tabindex="-1">
            When, where and how many?
          </h2>
        </legend>
        <fieldset>
          <legend class="group-label">Date</legend>
          <div class="choices">
            <Choice type="radio" name="dateKind" value="undecided" label="Not decided yet" />
            <Choice type="radio" name="dateKind" value="date" label="I have a date" />
          </div>
          <div class="field mt-4" data-date-field hidden>
            <label for="pl-date" class="field-label">
              Event date
            </label>
            <input id="pl-date" name="date" type="date" class="field-input" />
          </div>
        </fieldset>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          <div class="field">
            <label for="pl-guests" class="field-label">
              Approximate guests <span class="field-optional">optional</span>
            </label>
            <input
              id="pl-guests"
              name="guestCount"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              maxlength="6"
              class="field-input"
            />
          </div>
          <div class="field">
            <label for="pl-location" class="field-label">
              Venue or area <span class="field-optional">optional</span>
            </label>
            <input
              id="pl-location"
              name="location"
              type="text"
              maxlength={LIMITS.location}
              class="field-input"
              placeholder="e.g. a venue name or neighbourhood"
            />
          </div>
        </div>
        <fieldset class="mt-8">
          <legend class="group-label">
            Budget <span class="field-optional">optional</span>
          </legend>
          <div class="choices">
            {BUDGETS.map((b) => (
              <Choice type="radio" name="budget" value={b.id} label={b.label} />
            ))}
            <Choice type="radio" name="budget" value="" label="Rather not say" />
          </div>
        </fieldset>
        <div class="field mt-8">
          <label for="pl-notes" class="field-label">
            Anything else we should know? <span class="field-optional">optional</span>
          </label>
          <textarea
            id="pl-notes"
            name="notes"
            rows="4"
            maxlength={LIMITS.notes}
            class="field-input"
          ></textarea>
          <p class="stage-note">Please don’t include sensitive personal information here.</p>
        </div>
      </fieldset>

      <!-- 5. Contact -->
      <fieldset class="stage" data-stage="contact" hidden>
        <legend class="stage-legend">
          <h2 class="stage-title" tabindex="-1">
            How should we reach you?
          </h2>
        </legend>
        <div class="grid gap-6 sm:grid-cols-2">
          <div class="field">
            <label for="pl-name" class="field-label">
              Your name
            </label>
            <input
              id="pl-name"
              name="name"
              type="text"
              autocomplete="name"
              maxlength={LIMITS.name}
              class="field-input"
              required
            />
          </div>
          <div class="field">
            <label for="pl-phone" class="field-label">
              Phone or WhatsApp number
            </label>
            <input
              id="pl-phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              maxlength={LIMITS.phone}
              class="field-input"
              required
            />
          </div>
        </div>
        <fieldset class="mt-8">
          <legend class="group-label">Preferred way to talk</legend>
          <div class="choices">
            {CONTACT_CHANNELS.map((c) => (
              <Choice type="radio" name="contactChannel" value={c.id} label={c.label} />
            ))}
          </div>
        </fieldset>
        <div class="consent mt-8">
          <p class="text-[0.9375rem] text-charcoal">
            We will use your name and number only to respond to this enquiry. We don’t share them
            for marketing. A full privacy notice will be published before enquiries open.
          </p>
          <label class="check mt-5">
            <input type="checkbox" name="consent" value="yes" required />
            <span>I agree to The Wedding Nest using my details to respond to this enquiry.</span>
          </label>
          <label class="check mt-3">
            <input type="checkbox" name="marketingConsent" value="yes" />
            <span>
              Optional: I’m happy to hear about future offers and events.{" "}
              <span class="field-optional">You can say no and still enquire.</span>
            </span>
          </label>
        </div>
      </fieldset>

      <!-- Review -->
      <section class="stage" data-stage="review" hidden aria-labelledby="review-title">
        <h2 id="review-title" class="stage-title" tabindex="-1">
          Review your plan
        </h2>
        <dl class="summary mt-8" data-summary></dl>
        <div class="notice mt-10" role="note">
          <p class="eyebrow text-brass-deep">Preview only</p>
          <p class="mt-3 text-charcoal">
            Sending isn’t switched on yet, so nothing has been sent or stored. Once secure enquiries
            open, this is where you’ll send your plan to The Wedding Nest.
          </p>
          <p class="mt-3 text-charcoal">
            For now, you can reach the team on{" "}
            <a href={SITE.instagram} class="underline decoration-brass underline-offset-4">
              Instagram @twn.events
            </a>
          </p>
        </div>
      </section>

      <p class="planner-error" role="alert" data-error></p>

      <div class="planner-nav">
        <button type="button" class="link-underline nav-back" data-back hidden>
          ← Back
        </button>
        <span class="flex-1"></span>
        <button type="button" class="link-underline text-sm text-muted" data-reset>
          Start again
        </button>
        <button type="submit" class="btn btn-solid" data-next>
          <span data-next-label>Continue</span>{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </button>
      </div>
    </form>
  </div>
</div>

<style>
  :global(html:not(.js)) .js-only {
    display: none;
  }
  .planner :global(.progress-item) {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: baseline;
    padding: 1rem 0;
    color: var(--color-muted);
    transition: color 0.3s var(--ease-editorial);
  }
  .planner :global(.progress-num) {
    font-size: 1.5rem;
    font-weight: 300;
  }
  .planner :global(.progress-item[aria-current="step"]) {
    color: var(--color-ink);
  }
  .planner :global(.progress-item[aria-current="step"] .progress-num),
  .planner :global(.progress-item[data-done] .progress-num) {
    color: var(--color-brass-deep);
  }
  .progress-bar {
    width: 20%;
    transition: width 0.5s var(--ease-editorial);
  }
  .stage-legend {
    padding: 0;
    margin-bottom: 1.75rem;
  }
  .stage-title {
    font-size: var(--text-title);
    outline: none;
  }
  .stage-intro {
    margin-top: -1rem;
    color: var(--color-muted);
  }
  .group-label {
    display: block;
    margin-top: 2rem;
    margin-bottom: 0.9rem;
    font-size: 0.75rem;
    font-weight: 560;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-charcoal);
  }
  .stage-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .choices {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
  }
  .choices-wide {
    margin-top: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .planner :global(.choice) {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    min-height: 3.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    background: var(--color-paper);
    cursor: pointer;
    transition:
      border-color 0.25s var(--ease-editorial),
      background-color 0.25s var(--ease-editorial);
  }
  .planner :global(.choice:hover) {
    border-color: var(--color-ink);
  }
  .planner :global(.choice:has(:checked)) {
    border-color: var(--color-ink);
    background: var(--color-stone);
  }
  .planner :global(.choice:has(:focus-visible)) {
    outline: 2px solid var(--color-brass-deep);
    outline-offset: 2px;
  }
  .planner :global(.choice[hidden]) {
    display: none;
  }
  .planner :global(.choice-input) {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .planner :global(.choice-mark) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.2rem;
    border: 1px solid var(--color-charcoal);
    display: grid;
    place-items: center;
  }
  .planner :global(.choice:has(input[type="radio"]) .choice-mark) {
    border-radius: 999px;
  }
  .planner :global(.choice:has(:checked) .choice-mark) {
    background: var(--color-ink);
    border-color: var(--color-ink);
    box-shadow: inset 0 0 0 3px var(--color-stone);
  }
  .planner :global(.choice-text) {
    display: flex;
    flex-direction: column;
  }
  .planner :global(.choice-label) {
    font-weight: 500;
    line-height: 1.35;
  }
  .planner :global(.choice-hint) {
    margin-top: 0.2rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .planner :global(.swatch) {
    flex: none;
    width: 2.25rem;
    height: 2.75rem;
    border-radius: 999px 999px 0 0;
  }
  .planner :global(.swatch-heritage) {
    background: linear-gradient(160deg, #7a1f2b, #b08a3e 55%, #1f3b33);
  }
  .planner :global(.swatch-garden) {
    background: linear-gradient(160deg, #e9e3d2, #8fa77f 55%, #d9a5a0);
  }
  .planner :global(.swatch-minimal) {
    background: linear-gradient(160deg, #fbf8f2, #e6ddcd 60%, #cdbfa6);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08);
  }
  .planner :global(.swatch-grand) {
    background: linear-gradient(160deg, #2a2118, #c9a45c 50%, #f1e3c2);
  }
  .planner :global(.swatch-intimate) {
    background: linear-gradient(160deg, #e9c9b4, #b9785f 55%, #4a3a33);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .field-label {
    font-weight: 500;
  }
  .field-optional {
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-left: 0.25rem;
  }
  .field-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 28%, transparent);
    background: var(--color-paper);
    color: var(--color-ink);
    font: inherit;
  }
  .field-input:focus-visible {
    outline: 2px solid var(--color-brass-deep);
    outline-offset: 1px;
    border-color: var(--color-ink);
  }
  .field-input[aria-invalid="true"] {
    border-color: #9b2c2c;
  }
  .check {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    cursor: pointer;
  }
  .check input {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.25rem;
    accent-color: var(--color-ink);
  }
  .consent {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    background: var(--color-paper);
  }
  .summary {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .summary :global(dt),
  .summary :global(dd) {
    padding: 0.9rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .summary :global(dt) {
    color: var(--color-muted);
    font-size: 0.875rem;
    padding-right: 1rem;
  }
  .notice {
    padding: 1.5rem;
    border-left: 2px solid var(--color-brass);
    background: var(--color-paper);
  }
  .planner-error {
    margin-top: 1.5rem;
    min-height: 1.5rem;
    color: #9b2c2c;
    font-weight: 500;
  }
  .planner-nav {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .nav-back {
    font-weight: 500;
    min-height: 2.75rem;
  }
  .planner-nav [data-reset] {
    min-height: 2.75rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .stage:not([hidden]) {
      animation: stage-in 0.5s var(--ease-editorial);
    }
    @keyframes stage-in {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .progress-bar {
      transition: none;
    }
  }
</style>

<script>
  import { initPlanner } from "../../scripts/planner";
  const form = document.querySelector<HTMLFormElement>("[data-planner-form]");
  if (form) initPlanner(form);
</script>
