---
import "../styles/global.css";
// Preload only the above-the-fold latin files; the CSS would otherwise reveal them late.
import sansLatin from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import displayLatin from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PreviewNotice from "../components/PreviewNotice.astro";
import {
  ALLOW_INDEXING,
  SITE,
  canonicalUrl,
  organizationJsonLd,
  pageTitle,
  robotsContent,
} from "../lib/site/config";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = pageTitle(title);
const canonical = canonicalUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robotsContent(ALLOW_INDEXING)} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {[sansLatin, displayLatin].map((href) => (
      <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={href} />
    ))}
    <meta name="theme-color" content="#f6f1e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" is:inline set:html={organizationJsonLd()}></script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-ink focus:text-paper focus:px-4 focus:py-3 focus:rounded"
    >
      Skip to content
    </a>
    <PreviewNotice />
    <SiteHeader />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
