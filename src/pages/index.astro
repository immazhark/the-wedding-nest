---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Picture } from "astro:assets";
import Frame from "../components/media/Frame.astro";
import { approvedHomePhotos, approvedEventPhotos } from "../lib/media/catalog";
import { OCCASIONS, SERVICES, STAGES } from "../lib/enquiry/schema";
import { ENQUIRIES } from "../lib/site/config";
import { publishedServicePages, servicePageHref } from "../lib/services/publication";
import { publishedStories, featuredStoryPath } from "../lib/stories/publication";

// DRAFT COPY — editorial working draft pending owner approval (docs/creative-excellence-standards.md).
// No claims about prices, clients, venues, awards or guarantees.
const coreServices = SERVICES.filter((s) => !("onlyFor" in s));
const occasionServices = SERVICES.filter((s) => "onlyFor" in s);

// Plain descriptions of each tradition (general cultural meaning, not claims about TWN).
const occasionNotes: Record<string, string> = {
  nikah: "The marriage ceremony",
  walima: "The reception hosted by the groom’s family",
  mehndi: "The henna evening",
  shaadi: "The wedding day itself",
  engagement: "Often the first time both families gather",
  reception: "The celebration after the ceremony",
  sangeet: "An evening of music and dance",
};
const weddingOccasions = OCCASIONS.filter((o) => o.group === "wedding");
const otherOccasions = OCCASIONS.filter((o) => o.group === "celebration");
const featuredStory = featuredStoryPath(publishedStories);
// Each service door has its own jewel tone, so the row reads as a sequence of rooms, not identical cards.
const doorTones: Record<string, string> = {
  catering: "garnet",
  decor: "emerald",
  hospitality: "indigo",
  "venue-coordination": "kohl",
  "photo-film": "bronze",
  makeup: "rose",
  transport: "teal",
  invitations: "plum",
  gifting: "bronze",
};
const doorPhotos: Record<string, string> = {
  catering: "../../assets/events/catering/menu-table-details/01-savoury-bowl.jpg",
  decor: "../../assets/events/decor/hall-stage-decor/02-stage-seating.jpg",
  hospitality: "../../assets/events/celebrations/banquet-table/01-long-banquet-table.jpg",
  "venue-coordination":
    "../../assets/events/decor/hall-ceiling-chandeliers/01-chandelier-ceiling.jpg",
  "photo-film": "../../assets/events/celebrations/film-stills/01-hands-bokeh.jpg",
  transport: "../../assets/events/celebrations/decorated-car/01-garlanded-car.jpg",
  gifting: "../../assets/events/details/gift-box-ribbon/01-gold-gift-box-ribbon.jpg",
};
const thresholdPhoto =
  approvedEventPhotos["../../assets/events/catering/menu-table-details/04-white-dessert-glass.jpg"];
---

<BaseLayout>
  <!-- Opening: the grand entrance. Curtains part on the real stage photograph. -->
  <section class="grand" aria-labelledby="hero-title">
    <div class="grand-stage">
      <Frame
        photo={approvedHomePhotos["home-hero"]}
        aspectClass="h-full"
        tone="dark"
        placeholder="The opening photograph — a wide moment from a TWN wedding"
        priority
        sizes="100vw"
        quality={48}
        class="grand-photo"
        mediaClass="grand-media"
      />
      <div class="grand-scrim" aria-hidden="true"></div>
      <canvas class="grand-dust" data-dust aria-hidden="true"></canvas>
      <div class="grand-doors" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div class="grand-copy">
        <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 grand-copy-inner">
          <p class="eyebrow text-sand fade-in [--i:5]">
            Weddings and family celebrations<span class="hidden sm:inline"> · Hyderabad</span>
          </p>
          <h1
            id="hero-title"
            class="mt-5 text-[length:var(--text-display)] leading-[0.98] text-ivory"
          >
            <span class="line-mask grand-line">
              <span class="[--i:6]">Nikah to Walima,</span>
            </span>
            <span class="line-mask grand-line">
              <span class="[--i:7]">and every day</span>
            </span>
            <span class="line-mask grand-line md:pl-[1.6em]">
              <span class="[--i:8]">
                <em class="italic font-[300] text-saffron">between.</em>
              </span>
            </span>
          </h1>
          <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-x-8 gap-y-5 fade-in [--i:10]">
            <a href="/plan-your-event/" class="btn-grand">
              <span>Plan your event</span>
              <span class="btn-grand-chip" aria-hidden="true">
                →
              </span>
            </a>
            <a href="#services" class="link-underline text-[0.9375rem] font-medium text-ivory">
              What we do
            </a>
          </div>
          <p class="mt-8 max-w-md text-[length:var(--text-lede)] text-stone fade-in [--i:11]">
            We plan weddings and celebrations across Hyderabad — the whole occasion, or only the
            parts you’d like help with.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Catering: the table is where the celebration is remembered. Arch rises over the opening. -->
  <section class="kitchen arch-over on-dark" aria-labelledby="kitchen-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24 md:py-36 grid gap-14 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5">
        <div class="kitchen-arch" data-kitchen>
          <img
            src="/media/kitchen-loop-poster.jpg"
            alt=""
            width="960"
            height="540"
            loading="lazy"
            decoding="async"
            class="kitchen-poster"
          />
          <video
            class="kitchen-video"
            muted
            loop
            playsinline
            preload="none"
            poster="/media/kitchen-loop-poster.jpg"
            aria-label="A large pot of golden, saffron-streaked food being stirred"
            data-kitchen-video
          >
            <source src="/media/kitchen-loop.mp4" type="video/mp4" />
          </video>
        </div>
      </div>
      <div class="md:col-span-6 md:col-start-7">
        <p class="eyebrow text-saffron scroll-rise">Catering</p>
        <h2
          id="kitchen-title"
          class="mt-5 text-[length:var(--text-headline)] max-w-[14ch] text-ivory scroll-rise"
        >
          The table is where it is remembered.
        </h2>
        <p class="mt-6 max-w-lg text-[length:var(--text-lede)] text-stone scroll-rise">
          Four Hyderabadi menus, each open to your changes. Begin with one and shape it around your
          family.
        </p>
        <ul class="menu-rail mt-10" role="list">
          {[
            ["Deccani Delight", "Simple flavors, true Hyderabadi soul."],
            ["Nawabi Zaiqa", "A royal touch in every bite."],
            ["Daawat-E-Khaas", "For those who savor the special."],
            ["Shahi Dastarkhwaan", "The grandeur of Hyderabad on your table."],
          ].map(([name, line]) => (
            <li>
              <a href={servicePageHref("catering", publishedServicePages)} class="menu-rail-link">
                <span class="menu-rail-name">{name}</span>
                <span class="menu-rail-line">{line}</span>
                <span class="menu-rail-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Services: a row of doors, each with its own jewel tone -->
  <section id="services" class="services jaali py-24 md:py-36" aria-labelledby="services-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12">
      <div class="grid gap-12 md:grid-cols-12 md:items-end">
        <div class="md:col-span-5">
          <p class="eyebrow text-brass-deep">What we do</p>
          <h2 id="services-title" class="mt-5 text-[length:var(--text-headline)] max-w-[12ch]">
            All of it, or one part.
          </h2>
        </div>
        <div class="md:col-span-6 md:col-start-7 grid gap-6 text-charcoal">
          <p>
            <strong class="font-display text-[length:var(--text-title)] font-normal block text-ink">
              The whole occasion
            </strong>
            One planner and one team from the first meeting onwards: venue, décor, food, guests and
            the running of each day, across as many events as the wedding holds.
          </p>
          <p>
            <strong class="font-display text-[length:var(--text-title)] font-normal block text-ink">
              One part, or a few
            </strong>
            Catering for the Walima, décor for the Mehndi, cars for the baraat — ask for exactly
            what you need.
          </p>
        </div>
      </div>
      <div class="ornament mt-14 md:mt-20" aria-hidden="true">
        <span></span>
      </div>
      <ul class="service-doors mt-10 md:mt-12" aria-label="Services you can ask about">
        {coreServices.map((s, i) => (
          <li class={`door door-${i + 1}`} data-tone={doorTones[s.id] ?? "kohl"}>
            {doorPhotos[s.id] && approvedEventPhotos[doorPhotos[s.id]!] && (
              <Picture
                src={approvedEventPhotos[doorPhotos[s.id]!]!.image}
                alt=""
                formats={["avif", "webp"]}
                widths={[480, 800, 1200]}
                sizes="(min-width: 64rem) 55vw, 90vw"
                loading="lazy"
                class="door-photo"
                aria-hidden="true"
              />
            )}
            <a href={servicePageHref(s.id, publishedServicePages)} class="door-link">
              <span class="door-index" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="door-name">{s.label}</span>
              <span class="door-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-14 md:mt-20 max-w-4xl">
        <p class="text-sm font-medium tracking-wide text-charcoal">For particular occasions</p>
        <ul class="service-index service-chips mt-4" aria-label="Occasion-specific services">
          {occasionServices.map((s, i) => (
            <li>
              <a href={servicePageHref(s.id, publishedServicePages)} class="link-underline">
                {s.label}
              </a>
              {i < occasionServices.length - 1 && (
                <span class="text-brass" aria-hidden="true">
                  &nbsp;/
                </span>
              )}
            </li>
          ))}
        </ul>
        <p class="pt-8 text-sm text-muted max-w-xl">
          What’s possible depends on your date, venue and guest list. We’ll talk it through with you
          before anything is agreed.
        </p>
      </div>
    </div>
  </section>

  <!-- Occasions -->
  <!-- Film: two short owner-supplied films, loaded only when a visitor presses play. -->
  <section class="film on-dark arch-over" aria-labelledby="film-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 pt-28 pb-24 md:pt-40 md:pb-32">
      <p class="eyebrow text-saffron">The films</p>
      <h2 id="film-title" class="mt-5 text-[length:var(--text-headline)] text-ivory max-w-[18ch]">
        Watch how a celebration feels.
      </h2>
      <div class="film-grid mt-14">
        <div class="film-card film-wide" data-film>
          <img
            class="film-poster"
            src="/media/film-landscape-poster.jpg"
            alt=""
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
          <video
            class="film-video"
            controls
            playsinline
            preload="none"
            aria-describedby="film-wide-desc"
          >
            <source src="/media/film-landscape.mp4" type="video/mp4" />
          </video>
          <button
            type="button"
            class="film-play"
            data-film-play
            aria-label="Play the short film of wedding details"
            hidden
          >
            <span class="film-play-chip" aria-hidden="true">
              ▶
            </span>
          </button>
          <p id="film-wide-desc" class="film-desc">
            A short wedding film of details: hands, shoes, jewellery and a groom’s watch, about 24
            seconds, with music.
          </p>
        </div>
        <div class="film-card film-tall" data-film>
          <img
            class="film-poster"
            src="/media/film-portrait-poster.jpg"
            alt=""
            width="608"
            height="1080"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
          <video
            class="film-video"
            controls
            playsinline
            preload="none"
            aria-describedby="film-tall-desc"
          >
            <source src="/media/film-portrait.mp4" type="video/mp4" />
          </video>
          <button
            type="button"
            class="film-play"
            data-film-play
            aria-label="Play the short portrait wedding film"
            hidden
          >
            <span class="film-play-chip" aria-hidden="true">
              ▶
            </span>
          </button>
          <p id="film-tall-desc" class="film-desc">
            A short wedding film in portrait: a groom’s sherwani, silhouettes, bridal shoes and
            family embraces, about 50 seconds, with music.
          </p>
        </div>
      </div>
      <p class="mt-8 text-sand text-[0.9375rem] max-w-xl">
        Each film downloads only when you press play, and has sound.
      </p>
    </div>
  </section>

  <section id="occasions" class="occasions on-dark" aria-labelledby="occasions-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24 md:py-36">
      <p class="eyebrow text-saffron">Occasions</p>
      <h2 id="occasions-title" class="mt-5 max-w-4xl text-[length:var(--text-headline)] text-ivory">
        Rooted in Hyderabad’s wedding traditions. Open to every celebration.
      </h2>
      <div class="ornament ornament-dark mt-14" aria-hidden="true">
        <span></span>
      </div>
      <ul class="occasion-list mt-10" role="list">
        {weddingOccasions.map((o) => (
          <li class="occasion-row">
            <a href={`/plan-your-event/?occasion=${o.id}`} class="occasion-name">
              {o.label}
            </a>
            <span class="occasion-note">{occasionNotes[o.id]}</span>
          </li>
        ))}
      </ul>
      <div class="mt-12 max-w-3xl">
        <p class="eyebrow text-saffron">Other celebrations</p>
        <p class="mt-4 text-[length:var(--text-lede)] text-stone">
          For families and hosts from every community, and occasions of every kind.
        </p>
        <ul class="chip-row mt-6" aria-label="Other celebrations">
          {otherOccasions.map((o) => (
            <li>
              <a href={`/plan-your-event/?occasion=${o.id}`} class="chip-link">
                {o.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Planner invitation: the one place the arch appears (a threshold) -->
  <section id="approach" class="on-dark bg-kohl text-ivory" aria-labelledby="approach-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24 md:py-36 grid gap-14 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5 order-2 md:order-1">
        {thresholdPhoto ? (
          <figure class="threshold-arch">
            <Picture
              src={thresholdPhoto.image}
              alt={thresholdPhoto.entry.alt}
              formats={["avif", "webp"]}
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 30vw, 80vw"
              loading="lazy"
              class="threshold-photo"
            />
          </figure>
        ) : (
          <div class="threshold-arch" role="img" aria-label="Photograph to come"></div>
        )}
      </div>
      <div class="md:col-span-6 md:col-start-7 order-1 md:order-2">
        <h2 id="approach-title" class="text-[length:var(--text-headline)] max-w-[14ch]">
          Start with what you already know.
        </h2>
        <p class="mt-8 max-w-lg text-[length:var(--text-lede)] text-stone">
          Most families don’t have a date, a guest count or a budget at the first conversation. The
          planner asks five short questions and lets you skip anything that isn’t decided yet.
        </p>
        <p class="mt-8 text-sm tracking-[0.12em] uppercase text-sand" aria-label="Planner steps">
          {STAGES.map((s, i) => (
            <>
              {s.title}
              {i < STAGES.length - 1 && (
                <span class="text-brass" aria-hidden="true">
                  {" "}
                  —{" "}
                </span>
              )}
            </>
          ))}
        </p>
        <a href="/plan-your-event/" class="btn btn-light mt-10">
          Begin planning{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        {!ENQUIRIES.enabled && (
          <p class="mt-4 text-sm text-sand/80">Preview: the planner can’t send enquiries yet.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Work: asymmetric, mixed ratios, photography-ready -->
  <section class="gallery on-dark arch-over" aria-labelledby="work-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24 md:py-36">
      <p class="eyebrow text-saffron mb-5">The gallery</p>
      <div class="grid gap-6 md:grid-cols-12 md:items-end">
        <h2 id="work-title" class="md:col-span-7 text-[length:var(--text-headline)] text-ivory">
          Real celebrations, shared with permission.
        </h2>
        {featuredStory ? (
          <div class="md:col-span-4 md:col-start-9">
            <p class="text-sand">
              A celebration documented with its hosts’ and photographer’s permission.
            </p>
            <a
              class="link-underline inline-block mt-6 font-medium text-saffron"
              href={featuredStory}
            >
              Read an event story
            </a>
          </div>
        ) : (
          <p class="md:col-span-4 md:col-start-9 text-sand">
            Full event stories will be told here, each one only with the family’s permission.
          </p>
        )}
      </div>
      <div class="work-grid mt-16">
        <Frame
          photo={approvedHomePhotos["home-work-portrait"]}
          tone="dark"
          ratio="portrait"
          placeholder="A portrait moment from a wedding"
          sizes="(min-width: 768px) 42vw, 100vw"
          class="work-a"
        />
        <Frame
          photo={approvedHomePhotos["home-work-wide"]}
          tone="dark"
          ratio="landscape"
          placeholder="A wide view of a stage or venue"
          sizes="(min-width: 768px) 55vw, 100vw"
          class="work-b"
        />
        <Frame
          photo={approvedHomePhotos["home-work-detail"]}
          tone="dark"
          ratio="square"
          placeholder="A detail: florals, food or textiles"
          sizes="(min-width: 768px) 25vw, 100vw"
          class="work-c"
        />
        <p class="work-d text-stone">
          Each story will say what the family asked for, what we were responsible for, and who
          photographed it.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-row {
    display: grid;
    gap: 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .service-title {
    font-size: var(--text-title);
  }
  @media (min-width: 48rem) {
    .service-row {
      grid-template-columns: minmax(12rem, 0.8fr) 1.2fr;
      gap: 3rem;
    }
  }
  .service-index {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.55em;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
    font-weight: 330;
    line-height: 1.55;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .occasion-list {
    counter-reset: occasion;
    border-top: 1px solid color-mix(in srgb, var(--color-ivory) 20%, transparent);
  }
  .occasion-row {
    position: relative;
    counter-increment: occasion;
    display: grid;
    gap: 0.35rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ivory) 20%, transparent);
  }
  .occasion-row::before {
    content: counter(occasion, decimal-leading-zero);
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
    font-weight: 300;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-saffron) 45%, transparent);
    transition:
      -webkit-text-stroke-color 0.5s var(--ease-editorial),
      color 0.5s var(--ease-editorial);
    pointer-events: none;
  }
  .occasion-row:hover::before,
  .occasion-row:focus-within::before {
    color: color-mix(in srgb, var(--color-saffron) 14%, transparent);
    -webkit-text-stroke-color: var(--color-saffron);
  }
  .occasion-row::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--color-saffron);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-editorial);
  }
  .occasion-row:hover::after,
  .occasion-row:focus-within::after {
    transform: none;
  }
  @media (min-width: 48rem) {
    .occasion-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 2rem;
    }
  }
  .occasion-name {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.5rem + 3vw, 4.75rem);
    font-weight: 320;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ivory);
    transition:
      transform 0.6s var(--ease-editorial),
      color 0.4s var(--ease-editorial);
  }
  .occasion-row:hover .occasion-name,
  .occasion-name:focus-visible {
    transform: translateX(0.6rem);
    color: var(--color-saffron);
  }
  .occasion-note {
    color: var(--color-sand);
    font-size: 0.9375rem;
  }
  .work-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2rem;
      align-items: start;
    }
    .work-grid :global(.work-a) {
      grid-column: 1 / span 5;
      grid-row: 1 / span 2;
    }
    .work-grid :global(.work-b) {
      grid-column: 6 / span 7;
    }
    .work-grid :global(.work-c) {
      grid-column: 6 / span 3;
    }
    .work-grid :global(.work-d) {
      grid-column: 9 / span 4;
      align-self: end;
      max-width: 22rem;
    }
  }
  /* Royal framing: an arched portrait, gold hairlines held off the photographs, a saffron rule. */
  .work-grid :global(.work-a > :first-child) {
    border-radius: 999px 999px 0.75rem 0.75rem;
  }
  .work-grid :global(.work-a),
  .work-grid :global(.work-b),
  .work-grid :global(.work-c) {
    outline: 1px solid color-mix(in srgb, var(--color-saffron) 60%, transparent);
    outline-offset: 0.6rem;
    box-shadow: 0 2.5rem 4rem -1.5rem rgb(0 0 0 / 0.6);
  }
  .work-grid :global(.work-a) {
    border-radius: 999px 999px 0.75rem 0.75rem;
  }
  .work-grid :global(.work-b > :first-child),
  .work-grid :global(.work-c > :first-child) {
    border-radius: 0.75rem;
  }
  .work-grid :global(.work-b),
  .work-grid :global(.work-c) {
    border-radius: 0.75rem;
  }
  .work-grid :global(.work-d) {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-saffron);
  }
</style>

<script>
  import "../scripts/motion";
  // Films: nothing downloads until play. The native controls stay for no-JS and keyboard users;
  // with JS a single large play button leads, then hands over to the native controls.
  const players = document.querySelectorAll<HTMLElement>("[data-film]");
  players.forEach((card) => {
    const video = card.querySelector<HTMLVideoElement>("video");
    const button = card.querySelector<HTMLButtonElement>("[data-film-play]");
    if (!video || !button) return;
    video.controls = false;
    button.hidden = false;
    const start = () => {
      players.forEach((other) => other.querySelector("video")?.pause());
      video.controls = true;
      button.hidden = true;
      void video.play().catch(() => {
        button.hidden = false;
        video.controls = false;
      });
    };
    button.addEventListener("click", start);
  });
  // The kitchen loop plays only while visible, never with reduced motion, and has no audio track.
  const arch = document.querySelector<HTMLElement>("[data-kitchen]");
  const video = document.querySelector<HTMLVideoElement>("[data-kitchen-video]");
  const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (arch && video && !calm.matches && "IntersectionObserver" in window) {
    new IntersectionObserver(
      ([entry]) => {
        if (!entry) return;
        if (entry.isIntersecting && !calm.matches) {
          video
            .play()
            .then(() => arch.setAttribute("data-playing", ""))
            .catch(() => arch.removeAttribute("data-playing"));
        } else {
          video.pause();
        }
      },
      { threshold: 0.35 },
    ).observe(arch);
  }
</script>
