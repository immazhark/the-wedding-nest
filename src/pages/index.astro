---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchFrame from "../components/ArchFrame.astro";
import Frame from "../components/media/Frame.astro";
import { approvedHomePhotos } from "../lib/media/catalog";
import { OCCASIONS, SERVICES, STAGES } from "../lib/enquiry/schema";
import { ENQUIRIES } from "../lib/site/config";

// DRAFT COPY — editorial working draft pending owner approval (docs/creative-excellence-standards.md).
// No claims about prices, clients, venues, awards or guarantees.
const coreServices = SERVICES.filter((s) => !("onlyFor" in s));

// Plain descriptions of each tradition (general cultural meaning, not claims about TWN).
const occasionNotes: Record<string, string> = {
  nikah: "The marriage ceremony",
  walima: "The reception hosted by the groom’s family",
  mehndi: "The henna evening",
  shaadi: "The wedding day itself",
  engagement: "Often the first time both families gather",
  reception: "The celebration after the ceremony",
  sangeet: "An evening of music and dance",
};
const weddingOccasions = OCCASIONS.filter((o) => o.group === "wedding");
---

<BaseLayout>
  <!-- Opening -->
  <section class="opening" aria-labelledby="hero-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 pt-10 md:pt-16">
      <div class="grid gap-8 md:grid-cols-12 md:items-end">
        <div class="md:col-span-8">
          <p class="eyebrow text-brass-deep fade-in [--i:0]">
            Weddings and family celebrations<span class="hidden sm:inline"> · Hyderabad</span>
          </p>
          <h1 id="hero-title" class="mt-6 text-[length:var(--text-display)] leading-[0.98]">
            <span class="line-mask">
              <span class="[--i:1]">Nikah to Walima,</span>
            </span>
            <span class="line-mask">
              <span class="[--i:2]">and every day</span>
            </span>
            <span class="line-mask md:pl-[1.6em]">
              <span class="[--i:3]">
                <em class="italic font-[300] text-brass-deep">between.</em>
              </span>
            </span>
          </h1>
        </div>
        <div class="md:col-span-4 md:pb-3 fade-in [--i:4]">
          <p class="text-[length:var(--text-lede)] text-charcoal max-w-md">
            We plan weddings and celebrations across Hyderabad — the whole occasion, or only the
            parts you’d like help with.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
            <a href="/plan-your-event/" class="btn btn-solid">
              Plan your event{" "}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
            <a href="#services" class="link-underline text-[0.9375rem] font-medium">
              What we do
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="mx-auto max-w-[110rem] mt-10 md:mt-16 sm:px-8 lg:px-12">
      <Frame
        photo={approvedHomePhotos["home-hero"]}
        aspectClass="aspect-[4/5] sm:aspect-[3/2] lg:aspect-[21/9]"
        placeholder="The opening photograph — a wide moment from a TWN wedding"
        priority
        class="frame-reveal"
      />
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="py-24 md:py-36" aria-labelledby="services-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 grid gap-12 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="eyebrow text-brass-deep">What we do</p>
        <h2 id="services-title" class="mt-5 text-[length:var(--text-headline)] max-w-[12ch]">
          All of it, or one part.
        </h2>
      </div>
      <div class="md:col-span-8 border-t border-ink/15">
        <article class="service-row">
          <h3 class="service-title">The whole occasion</h3>
          <p class="text-charcoal">
            One planner and one team from the first meeting onwards: venue, décor, food, guests and
            the running of each day, across as many events as the wedding holds.
          </p>
        </article>
        <article class="service-row">
          <h3 class="service-title">One part, or a few</h3>
          <div>
            <p class="text-charcoal">
              Catering for the Walima, décor for the Mehndi, cars for the baraat — ask for exactly
              what you need.
            </p>
            <ul class="service-index mt-6" aria-label="Services you can ask about">
              {coreServices.map((s, i) => (
                <li>
                  <a href={`/plan-your-event/?service=${s.id}`} class="link-underline">
                    {s.label}
                  </a>
                  {i < coreServices.length - 1 && (
                    <span class="text-brass" aria-hidden="true">
                      &nbsp;/
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </article>
        <p class="pt-8 text-sm text-muted max-w-xl">
          What’s possible depends on your date, venue and guest list. We’ll talk it through with you
          before anything is agreed.
        </p>
      </div>
    </div>
  </section>

  <!-- Occasions -->
  <section id="occasions" class="bg-paper border-y border-ink/10" aria-labelledby="occasions-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24 md:py-36">
      <h2 id="occasions-title" class="max-w-4xl text-[length:var(--text-headline)]">
        Rooted in Hyderabad’s wedding traditions. Open to every celebration.
      </h2>
      <ul class="mt-16 border-t border-ink/15" role="list">
        {weddingOccasions.map((o) => (
          <li class="occasion-row scroll-rise">
            <a
              href={`/plan-your-event/?occasion=${o.id}`}
              class="occasion-name underline decoration-brass underline-offset-8"
            >
              {o.label}
            </a>
            <span class="occasion-note">{occasionNotes[o.id]}</span>
          </li>
        ))}
      </ul>
      <p class="mt-12 max-w-2xl text-[length:var(--text-lede)] text-charcoal">
        And birthdays, anniversaries, corporate evenings and private gatherings, for families and
        hosts from every community.
      </p>
    </div>
  </section>

  <!-- Planner invitation: the one place the arch appears (a threshold) -->
  <section id="approach" class="on-dark bg-kohl text-ivory" aria-labelledby="approach-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24 md:py-36 grid gap-14 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5 order-2 md:order-1">
        <ArchFrame
          tone="dark"
          label="Reserved for an approved décor or venue photograph"
          class="aspect-[4/5] w-full max-w-sm mx-auto md:mx-0"
        />
      </div>
      <div class="md:col-span-6 md:col-start-7 order-1 md:order-2">
        <h2 id="approach-title" class="text-[length:var(--text-headline)] max-w-[14ch]">
          Start with what you already know.
        </h2>
        <p class="mt-8 max-w-lg text-[length:var(--text-lede)] text-stone">
          Most families don’t have a date, a guest count or a budget at the first conversation. The
          planner asks five short questions and lets you skip anything that isn’t decided yet.
        </p>
        <p class="mt-8 text-sm tracking-[0.12em] uppercase text-sand" aria-label="Planner steps">
          {STAGES.map((s, i) => (
            <>
              {s.title}
              {i < STAGES.length - 1 && (
                <span class="text-brass" aria-hidden="true">
                  {" "}
                  —{" "}
                </span>
              )}
            </>
          ))}
        </p>
        <a href="/plan-your-event/" class="btn btn-light mt-10">
          Begin planning{" "}
          <span class="arrow" aria-hidden="true">
            →
          </span>
        </a>
        {!ENQUIRIES.enabled && (
          <p class="mt-4 text-sm text-sand/80">Preview: the planner can’t send enquiries yet.</p>
        )}
      </div>
    </div>
  </section>

  <!-- Work: asymmetric, mixed ratios, photography-ready -->
  <section aria-labelledby="work-title">
    <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24 md:py-36">
      <div class="grid gap-6 md:grid-cols-12 md:items-end">
        <h2 id="work-title" class="md:col-span-7 text-[length:var(--text-headline)]">
          Real celebrations, shared with permission.
        </h2>
        <p class="md:col-span-4 md:col-start-9 text-muted">
          Project stories will appear here once the photographs and the families’ permission are
          confirmed.
        </p>
      </div>
      <div class="work-grid mt-16">
        <Frame
          photo={approvedHomePhotos["home-work-portrait"]}
          ratio="portrait"
          placeholder="A portrait moment from a wedding"
          sizes="(min-width: 768px) 42vw, 100vw"
          class="work-a"
        />
        <Frame
          photo={approvedHomePhotos["home-work-wide"]}
          ratio="landscape"
          placeholder="A wide view of a stage or venue"
          sizes="(min-width: 768px) 55vw, 100vw"
          class="work-b"
        />
        <Frame
          photo={approvedHomePhotos["home-work-detail"]}
          ratio="square"
          placeholder="A detail: florals, food or textiles"
          sizes="(min-width: 768px) 25vw, 100vw"
          class="work-c"
        />
        <p class="work-d text-charcoal">
          Each story will say what the family asked for, what we were responsible for, and who
          photographed it.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-row {
    display: grid;
    gap: 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  .service-title {
    font-size: var(--text-title);
  }
  @media (min-width: 48rem) {
    .service-row {
      grid-template-columns: minmax(12rem, 0.8fr) 1.2fr;
      gap: 3rem;
    }
  }
  .service-index {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.55em;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.55rem);
    font-weight: 330;
    line-height: 1.55;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .occasion-row {
    display: grid;
    gap: 0.35rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }
  @media (min-width: 48rem) {
    .occasion-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 2rem;
    }
  }
  .occasion-name {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 1.5rem + 3vw, 4.75rem);
    font-weight: 320;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .occasion-note {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .work-grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 2rem;
      align-items: start;
    }
    .work-grid :global(.work-a) {
      grid-column: 1 / span 5;
      grid-row: 1 / span 2;
    }
    .work-grid :global(.work-b) {
      grid-column: 6 / span 7;
    }
    .work-grid :global(.work-c) {
      grid-column: 6 / span 3;
    }
    .work-grid :global(.work-d) {
      grid-column: 9 / span 4;
      align-self: end;
      max-width: 22rem;
    }
  }
</style>
