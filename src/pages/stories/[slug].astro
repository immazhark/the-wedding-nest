---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Frame from "../../components/media/Frame.astro";
import { publishedStories, type ApprovedStory } from "../../lib/stories/publication";
import { storyPlannerHref } from "../../lib/stories/planner-link";

// No case-study pages exist without owner-reviewed written facts and real photographs.
export const getStaticPaths = (() =>
  publishedStories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }))) satisfies GetStaticPaths;

interface Props {
  story: ApprovedStory;
}
const { story } = Astro.props;
const [hero, ...gallery] = story.photos;
const plannerHref = storyPlannerHref(story.occasion);
---

<BaseLayout title={story.title} description={story.introduction}>
  <article>
    <div class="page-hero on-dark">
      <header class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 pt-10 pb-12 md:pt-24 md:pb-16">
        <div class="grid gap-8 md:grid-cols-12 md:items-end">
          <div class="md:col-span-8">
            <p class="eyebrow text-saffron fade-in [--i:1]">An event story · {story.occasion}</p>
            <h1 class="mt-7 text-[length:var(--text-display)] max-w-[14ch] text-ivory fade-in [--i:2]">
              {story.title}
            </h1>
          </div>
          <p class="md:col-span-4 text-[length:var(--text-lede)] text-stone fade-in [--i:3]">
            {story.introduction}
          </p>
        </div>
      </header>

      <div class="mx-auto max-w-[110rem] sm:px-8 lg:px-12 pb-24 md:pb-32">
        {hero && (
          <Frame
            photo={hero}
            ratio={hero.entry.orientation}
            sizes="(min-width: 1024px) 90vw, 100vw"
            priority
          />
        )}
      </div>
    </div>

    <section class="arch-over planner-stage">
      <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 pt-24 pb-20 md:pt-36 md:pb-32">
        <div class="grid gap-14 md:grid-cols-12">
          <div class="md:col-span-5">
            <p class="eyebrow text-brass-deep">The brief</p>
            <h2 class="mt-5 text-[length:var(--text-headline)]">What the hosts asked for.</h2>
            <p class="mt-8 text-charcoal max-w-xl">{story.brief}</p>
          </div>
          <div class="md:col-span-6 md:col-start-7">
            <p class="eyebrow text-brass-deep">Our contribution</p>
            <h2 class="mt-5 text-[length:var(--text-headline)]">The part we delivered.</h2>
            <p class="mt-8 text-charcoal max-w-xl">{story.contribution}</p>
          </div>
        </div>
        <div class="story-gallery mt-20 md:mt-28 grid gap-10 md:grid-cols-2 md:gap-12">
          {gallery.map((photo) => (
            <Frame
              photo={photo}
              ratio={photo.entry.orientation}
              sizes="(min-width: 768px) 47vw, 100vw"
            />
          ))}
        </div>
      </div>
    </section>
    <aside class="svc-close on-dark">
      <div class="mx-auto max-w-[90rem] px-4 sm:px-8 lg:px-12 py-24">
        <p class="eyebrow text-saffron">Your own occasion</p>
        <h2 class="mt-5 text-[length:var(--text-headline)] text-ivory">
          Tell us what you're planning.
        </h2>
        <a class="btn-grand mt-9" href={plannerHref}>
          <span>Start planning</span>
          <span class="btn-grand-chip" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </aside>
  </article>
</BaseLayout>
