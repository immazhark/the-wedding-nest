{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-wedding-nest",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only the API runs Worker code; every page is served straight from static assets.
    "run_worker_first": ["/api/*", "/operator", "/operator/*"],
  },
  // workers.dev + per-version preview URLs for review. No custom domain until owner approval.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Production (default env): enquiry intake OFF and no database bound. Switching on live
  // submission is owner-gated and needs a production D1 + secret + retention policy first.
  "vars": { "ENQUIRIES_ENABLED": "false" },

  // Branch previews are isolated from production and cannot accept enquiries.
  "previews": {
    "vars": { "ENQUIRIES_ENABLED": "false" },
  },

  "env": {
    // Isolated staging: its own Worker name, its own D1 database, test data only.
    // Deploy: npx wrangler deploy --env staging (after creating the DB; see docs/enquiry-api.md).
    "staging": {
      "name": "the-wedding-nest-staging",
      "vars": {
        "ENQUIRIES_ENABLED": "true",
        "ALLOWED_ORIGINS": "https://the-wedding-nest-staging.mazharkhan-it.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "twn-enquiries-staging",
          // Isolated test database; schema applied through the Cloudflare API.
          "database_id": "7a2c8b44-f24d-48e6-ba95-56aa039d60e8",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
