{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only for M0. A Worker entry for POST /api/enquiry (+ D1) is added in M2.
  "name": "the-wedding-nest",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  // workers.dev + per-version preview URLs for review. No custom domain until owner approval.
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
}
